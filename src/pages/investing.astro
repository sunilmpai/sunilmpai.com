---
import Layout from '../layouts/Layout.astro';

const companies = [
  { name: "Cognition", url: "https://cognition.com/", logo: "/company-logos/cognition.svg" },
  { name: "Anduril", url: "https://www.anduril.com/", logo: "/company-logos/anduril.png" },
  { name: "Micro1", url: "https://www.micro1.ai/", logo: "/company-logos/micro1.svg" },
  { name: "Higgsfield", url: "https://higgsfield.ai/", logo: "/company-logos/higgsfield.svg" },
  { name: "ArenaAI", url: "https://arena.ai/", logo: "/company-logos/arena-ai.svg" },
  { name: "Mercury", url: "https://mercury.com/", logo: "/company-logos/mercury.svg" },
  { name: "Genesis", url: "https://www.genesis.ai/", logo: "/company-logos/genesis.svg" },
  { name: "Erebor", url: "https://erebor.bank/", logo: "/company-logos/erebor.svg" },
];
---

<Layout title="Investing - Sunil M Pai">
  <div class="grid layout-float">
    <div class="profile-image">
      <figure>
        <img src="/investing.jpg" alt="Sunil at a poker table" />
        <figcaption class="photo-caption">Poker at Satya's!</figcaption>
      </figure>
    </div>
    <div class="bio">
      <h1>Investing</h1>
      <p>I began my individual investing career as a scout for Lightspeed Venture Partners. They trusted my instincts and gave me a pool of capital to invest at my sole discretion. That fund is the highest performing scout fund in the program's history.</p>
      <p>Since 2019, my angel track record is a 8x DPI (distributed 8+ times the capital originally invested) and on track to reach 17.5x when fully realized.</p>

      <p>In addition to my personal investments, I run <a href="https://www.angelcollective.com/" target="_blank" rel="noopener noreferrer">Angel Collective</a> with my partner, <a href="https://www.linkedin.com/in/candito/" target="_blank" rel="noopener noreferrer">Nick Candito</a>.
        I believe investing other peoples' money is a privilege and a responsibility.</p>

      <ul class="company-grid" aria-label="Selected investments" role="list">
        {companies.map((company) => (
          <li>
            <a href={company.url} target="_blank" rel="noopener noreferrer">
              <img
                class:list={["company-logo", { "company-logo--wide": company.name === "Micro1" }]}
                src={company.logo}
                alt=""
                width="32"
                height="28"
                loading="lazy"
                decoding="async"
              />
              <span>{company.name}</span>
            </a>
          </li>
        ))}
      </ul>

      <h2>Advising</h2>
      <p>I serve as a hands-on advisor to several startups:</p>
      <ul class="advising-list">
        <li class="advising-item">
          <div class="advising-description">
            <a href="https://www.akashsystems.com/" target="_blank" rel="noopener noreferrer">Akash Systems</a> - Builds energy and capital efficient AI infrastructure.
          </div>
          <div class="advising-meta">Series B · Founders Fund, Khosla Ventures</div>
        </li>
        <li class="advising-item">
          <div class="advising-description">
            <a href="https://www.athena.com/" target="_blank" rel="noopener noreferrer">Athena</a> - A human+machine assistant company.
          </div>
          <div class="advising-meta">Series A · Khosla Ventures</div>
        </li>
        <li class="advising-item">
          <div class="advising-description">
            <a href="https://daylightcomputer.com/" target="_blank" rel="noopener noreferrer">Daylight Computer</a> - A new kind of computer, designed for deep focus and wellbeing.
          </div>
          <div class="advising-meta">Series A · Lachy Groom, Dan Romero, Balaji, Claire Hughes Johnson</div>
        </li>
        <li class="advising-item">
          <div class="advising-description">
            <a href="https://getaccess.com/" target="_blank" rel="noopener noreferrer">Get Access</a> - A membership platform for investing in growth-stage private companies.
          </div>
          <div class="advising-meta">Seed · Sound Ventures, Aaron Levie, Kevin Hartz, Josh Wolfe, Tim Ferriss</div>
        </li>
      </ul>

      <h2>What I Look For</h2>
      <p>I love investing because I love being in dialogue with people who are at the pinnacle of their fields. I am a founder-driven investor and have invested in everything from early stage B2B SaaS to an oil refinery project in The Gambia.</p>
      <p>I like to help founders with growth/distribution, product, operational discipline, and fundraising.</p>
      <p>I work best with founders that communicate transparently, are often technical or very structured in their thinking, and operate with a high degree of agency.</p>
    </div>
  </div>
</Layout>

<style>
  .company-grid {
    --grid-line: #ededed;
    --grid-cell: #fff;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    max-width: 420px;
    list-style: none;
    margin: 1.5rem 0 1.75rem;
    padding: 0;
    background: var(--grid-line);
  }

  .company-grid li {
    min-width: 0;
    margin: 0;
    background: var(--grid-cell);
  }

  .company-grid a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    box-sizing: border-box;
    min-height: 76px;
    padding: 0.65rem 0.25rem;
    color: #666;
    text-align: center;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .company-grid a:hover {
    color: #111;
  }

  .company-grid a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -3px;
    border-radius: 2px;
  }

  .company-logo {
    display: block;
    width: 32px;
    height: 28px;
    object-fit: contain;
  }

  .company-logo--wide {
    width: 44px;
  }

  .company-grid span {
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
  }

  :global(html.dark) .company-grid {
    --grid-line: #292929;
    --grid-cell: #111;
  }

  :global(html.dark) .company-grid a {
    color: #999;
  }

  :global(html.dark) .company-grid a:hover {
    color: #eee;
  }

  :global(html.dark) .company-logo {
    filter: invert(1);
  }
</style>
